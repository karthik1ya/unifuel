# ==========================================
# UniFuel - Git Ignore
# ==========================================

# Maven
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Java compiled files
*.class

# Spring Boot generated files
HELP.md

# Environment variables and secrets
.env
.env.*
!.env.example
application-local.properties
application-secret.properties

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Spring Tool Suite (STS) / Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Gradle
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Visual Studio Code
.vscode/

# Logs
*.log
logs/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.bak